# Copy to .env and fill in. Never commit .env.
# Local Ollama (demo). For a gateway like LiteLLM, change only these URLs and keys.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3-14b
EMBED_BASE_URL=http://localhost:11434/v1
EMBED_API_KEY=ollama
EMBED_MODEL=bge-m3
SIMILARITY_THRESHOLD=0.55

# The demo follows the real date. To pin "today" (e.g. for screenshots), set it here, like 2026-10-25 (3 Aban 1405).
DEMO_TODAY=
# The demo data is rebuilt on startup when it was made on another day. Set to 1 to keep it.
KEEP_DB=
