# Copy to .env and fill in. Never commit .env.
# Local Ollama (demo). For a gateway like LiteLLM, change only these URLs and keys.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3-14b
EMBED_BASE_URL=http://localhost:11434/v1
EMBED_API_KEY=ollama
EMBED_MODEL=bge-m3
# Local Qwen3 is told not to think with "/no_think" (default). A hosted API turns thinking off with a request field instead:
# LLM_NO_THINK=0
# LLM_EXTRA={"enable_thinking": false}
LLM_NO_THINK=
LLM_EXTRA=

# Example: AvalAI (works from servers in Iran). Run `python ingest.py` again after changing the embedding model.
# LLM_BASE_URL=https://api.avalai.ir/v1
# LLM_MODEL=qwen3.8-flash
# EMBED_BASE_URL=https://api.avalai.ir/v1
# EMBED_MODEL=gemini-embedding-001
SIMILARITY_THRESHOLD=0.55

# The demo follows the real date. To pin "today" (e.g. for screenshots), set it here, like 2026-10-25 (3 Aban 1405).
DEMO_TODAY=
# The demo data is rebuilt on startup when it was made on another day. Set to 1 to keep it.
KEEP_DB=

# Live server only. SITE_PASSWORD turns on the site's door (one username and password before anything else).
# Never put the real password in this file or anywhere in the repo; it goes in the server's .env only.
SITE_USER=
SITE_PASSWORD=
# Live server only. ADMIN_PASSWORD makes every assistant ask for a login (the cards after the door).
# This account opens every assistant and gives other people access on the assistants page. Real values in the server's .env only.
ADMIN_USER=
ADMIN_PASSWORD=
# 1: every reload of the page forgets the school, so each visit starts on an empty setup form.
RESET_ON_LOAD=
