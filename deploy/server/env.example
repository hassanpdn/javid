# /etc/server-backup/env (chmod 600, root only). Copied from deploy/server/env.example and filled in.
RESTIC_REPOSITORY=rclone:gdrive:server-backups
RESTIC_PASSWORD_FILE=/etc/server-backup/restic-password
# What is backed up (spaces between): leave as it is unless a project lives elsewhere
BACKUP_PATHS=/opt /var/www /etc /home /root /var/backups
# Where an alert goes when a night fails (the same Gmail app password as in /opt/javid/.env)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL=
