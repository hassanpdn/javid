# The eco-lodge's public website on its own address. The same app answers (uvicorn on 127.0.0.1:8000); app.py sees
# the Host header and, for LODGE_HOST, serves only the lodge's page and its public API. certbot adds the HTTPS part.
server {
    listen 80;
    server_name eco.pudineh.com;

    client_max_body_size 10m;    # photos of receipts (at most 6 MB, sent as base64)

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
